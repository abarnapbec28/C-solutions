#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    char *s = (char *)malloc(1001 * sizeof(char));
    if (s == NULL) {
        return 1;
    }

    if (scanf("%1000s", s) != 1) {
        free(s);
        return 0;
    }

    int frequencies[10] = {0};
    int len = strlen(s);

    for (int i = 0; i < len; i++) {
        if (s[i] >= '0' && s[i] <= '9') {
            frequencies[s[i] - '0']++;
        }
    }

    for (int i = 0; i < 10; i++) {
        printf("%d", frequencies[i]);
        if (i < 9) {
            printf(" ");
        }
    }
    printf("\n");

    free(s);
    return 0;
}
