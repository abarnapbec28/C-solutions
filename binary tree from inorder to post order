#include <stdlib.h>

struct HashEntry {
    int key;
    int val;
};

int findInorderIndex(struct HashEntry* hash, int size, int key) {
    int hashIdx = (key < 0 ? -key : key) % size;
    while (hash[hashIdx].key != key) {
        hashIdx = (hashIdx + 1) % size;
    }
    return hash[hashIdx].val;
}

struct TreeNode* buildTreeHelper(int* postorder, int* postIdx, int inStart, int inEnd, struct HashEntry* hash, int hashSize) {
    if (inStart > inEnd) {
        return NULL;
    }

    int rootVal = postorder[*postIdx];
    (*postIdx)--;

    struct TreeNode* root = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    root->val = rootVal;
    root->left = NULL;
    root->right = NULL;

    int inIdx = findInorderIndex(hash, hashSize, rootVal);

    root->right = buildTreeHelper(postorder, postIdx, inIdx + 1, inEnd, hash, hashSize);
    root->left = buildTreeHelper(postorder, postIdx, inStart, inIdx - 1, hash, hashSize);

    return root;
}

struct TreeNode* buildTree(int* inorder, int inorderSize, int* postorder, int postorderSize) {
    if (inorderSize == 0 || postorderSize == 0) {
        return NULL;
    }

    int hashSize = inorderSize * 2;
    struct HashEntry* hash = (struct HashEntry*)calloc(hashSize, sizeof(struct HashEntry));

    for (int i = 0; i < hashSize; i++) {
        hash[i].key = 4000; 
    }

    for (int i = 0; i < inorderSize; i++) {
        int key = inorder[i];
        int hashIdx = (key < 0 ? -key : key) % hashSize;
        while (hash[hashIdx].key != 4000) {
            hashIdx = (hashIdx + 1) % hashSize;
        }
        hash[hashIdx].key = key;
        hash[hashIdx].val = i;
    }

    int postIdx = postorderSize - 1;
    struct TreeNode* root = buildTreeHelper(postorder, &postIdx, 0, inorderSize - 1, hash, hashSize);

    free(hash);
    return root;
}
