#include <math.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Ensure nums1 is the smaller array to optimize binary search runtime to O(log(min(m, n)))
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }
    
    int m = nums1Size;
    int n = nums2Size;
    int low = 0;
    int high = m;
    
    while (low <= high) {
        int partitionX = (low + high) / 2;
        int partitionY = (m + n + 1) / 2 - partitionX;
        
        // If partitionX is 0, nothing is on the left side for nums1. Use -INFINITY
        // If partitionX is m, nothing is on the right side for nums1. Use INFINITY
        int maxLeftX = (partitionX == 0) ? -2e9 : nums1[partitionX - 1];
        int minRightX = (partitionX == m) ? 2e9 : nums1[partitionX];
        
        int maxLeftY = (partitionY == 0) ? -2e9 : nums2[partitionY - 1];
        int minRightY = (partitionY == n) ? 2e9 : nums2[partitionY];
        
        // Check if we found the correct partition
        if (maxLeftX <= minRightY && maxLeftY <= minRightX) {
            // If the total number of elements is odd
            if ((m + n) % 2 != 0) {
                return (double)MAX(maxLeftX, maxLeftY);
            }
            // If the total number of elements is even
            else {
                return ((double)MAX(maxLeftX, maxLeftY) + MIN(minRightX, minRightY)) / 2.0;
            }
        }
        // Move towards the left in nums1
        else if (maxLeftX > minRightY) {
            high = partitionX - 1;
        }
        // Move towards the right in nums1
        else {
            low = partitionX + 1;
        }
    }
    
    return 0.0;
}
