#include <stdio.h>
#include <stdlib.h>
#include <math.h>

struct triangle
{
	int a;
	int b;
	int c;
};

typedef struct triangle triangle;
double calculate_area_sq(triangle t) {
    double p = (t.a + t.b + t.c) / 2.0;
    return p * (p - t.a) * (p - t.b) * (p - t.c);
}

void sort_by_area(triangle* tr, int n) {
    double* areas = malloc(n * sizeof(double));
    for (int i = 0; i < n; i++) {
        areas[i] = calculate_area_sq(tr[i]);
    }

    // Standard Bubble Sort to sort both areas array and triangles array
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (areas[j] > areas[j + 1]) {
                // Swap areas
                double temp_area = areas[j];
                areas[j] = areas[j + 1];
                areas[j + 1] = temp_area;

                // Swap corresponding triangles
                triangle temp_tr = tr[j];
                tr[j] = tr[j + 1];
                tr[j + 1] = temp_tr;
            }
        }
    }
    free(areas);
}

int main()
{
	int n;
	scanf("%d", &n);
	triangle *tr = malloc(n * sizeof(triangle));
	for (int i = 0; i < n; i++) {
		scanf("%d%d%d", &tr[i].a, &tr[i].b, &tr[i].c);
	}
	sort_by_area(tr, n);
	for (int i = 0; i < n; i++) {
		printf("%d %d %d\n", tr[i].a, tr[i].b, tr[i].c);
	}
	return 0;
}
